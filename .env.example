# Copy to .env.local for local dev

# Site URL (production)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Optional: remote waitlist API for GitHub Pages static site (e.g. https://your-app.vercel.app/api/waitlist)
NEXT_PUBLIC_WAITLIST_API_URL=

# Supabase — required for live waitlist + auth in production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM (optional — app intel features)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
SERPER_API_KEY=
