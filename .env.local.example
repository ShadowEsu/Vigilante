# Supabase (auth + waitlist)
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM providers
ANTHROPIC_API_KEY=your-anthropic-key
GOOGLE_API_KEY=your-google-key

# Google search (pick one — improves company source discovery)
# Serper.dev — https://serper.dev (recommended, Google results API)
SERPER_API_KEY=your-serper-key
# OR Google Custom Search — https://developers.google.com/custom-search
GOOGLE_CSE_API_KEY=your-cse-api-key
GOOGLE_CSE_ID=your-search-engine-id
