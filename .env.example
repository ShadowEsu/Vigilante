# Copy to .env.local for local dev

# Site URL (3002 — 3001 is reserved for the FreeLLMAPI dashboard)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Supabase — waitlist + auth (project: Regrade-waitlist)
NEXT_PUBLIC_SUPABASE_URL=https://lshqzxgzehgmzgeilvmy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-dashboard

# Optional: service role for server-side admin (Settings → API → service_role)
# Waitlist works with anon key only — this is optional for local/Vercel API routes
SUPABASE_SERVICE_ROLE_KEY=


# Waitlist notification (FormSubmit → your inbox; user gets autoresponse)
WAITLIST_NOTIFY_EMAIL=regradeteam@gmail.com
NEXT_PUBLIC_WAITLIST_NOTIFY_EMAIL=regradeteam@gmail.com

# ─── LLM backend ──────────────────────────────────────────────────────────────
# Vigilante talks the Anthropic Messages API. Point it at EITHER FreeLLMAPI
# (free-tier capacity, default) OR Anthropic directly — never both.
#
# Option A — FreeLLMAPI (recommended, no paid credits):
#   1. git clone https://github.com/tashfeenahmed/freellmapi && cd freellmapi
#   2. docker compose up -d
#   3. open http://localhost:3001 → Keys page → add free provider keys
#      (Google Gemini, Groq, Cerebras, Mistral, OpenRouter, ...)
#   4. copy the unified key (freellmapi-...) from the Keys page header
ANTHROPIC_BASE_URL=http://localhost:3001
ANTHROPIC_AUTH_TOKEN=

# Option B — Anthropic direct (paid). Leave the two above BLANK if you use this.
# WARNING: never set this alongside ANTHROPIC_AUTH_TOKEN. The Anthropic SDK
# prefers x-api-key over the Bearer token, so a value here silently bypasses
# FreeLLMAPI auth and every request fails.
ANTHROPIC_API_KEY=

GOOGLE_API_KEY=
SERPER_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Agent tuning (optional — leave blank to use per-backend defaults).
# On FreeLLMAPI these default to "auto" (its cross-provider router picks the
# best healthy free model). Pin one instead if you want, e.g. gemini-2.5-flash.
AGENT_DETECT_MODEL=
AGENT_BRIEF_MODEL=
AGENT_ASK_MODEL=
AGENT_MAX_SOURCE_CHARS=12000
AGENT_DEFAULT_CADENCE_MIN=1440
AGENT_DEFAULT_BUDGET_USD=10
VIGILANTE_STORAGE=local

# Scheduled runs (Vercel Cron → GET /api/cron/run)
CRON_SECRET=
CRON_BATCH_SIZE=10

# Outbound integrations (server-side — no UI required)
VIGILANTE_SLACK_WEBHOOK_URL=
WEBHOOK_URL=
WEBHOOK_SIGNING_SECRET=
